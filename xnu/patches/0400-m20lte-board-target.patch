+/* Caller owns a5xelte_emmc_lock and has masked controller interrupts. */
+static int
+emmc_command(uint32_t opcode, uint32_t arg, bool stop, uint32_t *response)
+{
+	uint32_t command = CMD_START | CMD_RESP_CRC | CMD_RESP | opcode |
+	    (stop ? CMD_STOP : CMD_WAIT_DATA);
+	if ((emmc_rd(EMMC_CLKSEL) >> 16) & 7u) command |= CMD_HOLD;
+	emmc_wr(EMMC_RINTSTS, 0xffffffffu);
+	emmc_wr(EMMC_CMDARG, arg);
+	emmc_wr(EMMC_CMD, command);
+	for (unsigned i = 0; i < A5_EMMC_POLL_LIMIT; i++) {
+		uint32_t pending = emmc_rd(EMMC_RINTSTS);
+		if (pending & INT_ERRORS) return EIO;
+		if (pending & INT_CMD_DONE) {
+			*response = emmc_rd(EMMC_RESP0);
+			return (*response & A5_EMMC_R1_ERRORS) ? EIO : 0;
+		}
+	}
+	return ETIMEDOUT;
+}
+
+static int
+emmc_wait_idle(void)
+{
+	for (unsigned i = 0; i < A5_EMMC_POLL_LIMIT; i++) {
+		if (!(emmc_rd(EMMC_STATUS) & (1u << 9))) return 0;
+	}
+	return ETIMEDOUT;
+}
+
+/* Linux's SBC request sends CMD23 first and omits CMD12 on success.
+ * On data error, explicitly stop/abort as dw_mci_prep_stop does. Never
+ * replay a partially written multi-block request as single-sector writes. */
+static int
+emmc_transfer_blocks(uint32_t lba, uint8_t *buffer, uint32_t blocks, bool write)
+{
+	uint64_t address = lba;
+	if (!buffer || blocks < 2 || blocks > A5_EMMC_MAX_BLOCKS ||
+	    address < emmc_first_lba || address - emmc_first_lba >= emmc_nsectors ||
+	    blocks > emmc_nsectors - (address - emmc_first_lba) ||
+	    blocks - 1u > UINT32_MAX - lba) return EINVAL;
+	if (write && !emmc_writable) return EROFS;
+	if (emmc_io_poisoned) return EIO;
+	uint32_t hcon = emmc_rd(EMMC_HCON), width = (hcon >> 7) & 7u;
+	uint32_t ver = emmc_rd(EMMC_VERID) & 0xffffu;
+	if (width > 2 || !ver || ver == 0xffff ||
+	    !(emmc_rd(EMMC_PWREN) & 1u) || !(emmc_rd(EMMC_CLKENA) & 1u)) return ENXIO;
+	if (emmc_rd(EMMC_STATUS) & (1u << 9)) return EBUSY;
+	uint32_t unit = 2u << width, bytes = blocks * 512u, moved = 0;
+	uint32_t data_off = ver < 0x240au ? 0x100u : 0x200u;
+	uint32_t ints = emmc_rd(EMMC_INTMASK), response = 0;
+	bool data_started = false;
+	unsigned phase = 1;
+	int error = 0;
+	emmc_wr(EMMC_INTMASK, 0);
+	emmc_wr(EMMC_CTRL, (emmc_rd(EMMC_CTRL) &
+	    ~(CTRL_INT_ENABLE | CTRL_DMA_ENABLE | CTRL_USE_IDMAC)) | CTRL_FIFO_RESET);
+	for (unsigned i = 0; ; i++) {
+		if (!(emmc_rd(EMMC_CTRL) & CTRL_FIFO_RESET)) break;
+		if (i == A5_EMMC_POLL_LIMIT - 1) { error = ETIMEDOUT; goto out; }
+	}
+	emmc_wr(EMMC_TMOUT, 0x573177ffu);
+	phase = 2;
+	error = emmc_command(23u, blocks, false, &response);
+	if (error) {
+		/* A completed ILLEGAL_COMMAND rejects SBC before any data command.
+		 * Only this case can safely use the legacy path for this request. */
+		if (error == EIO && (response & A5_EMMC_R1_ERRORS) == (1u << 22)) error = ENOTSUP;
+		goto out;
+	}
+	emmc_wr(EMMC_BLKSIZ, 512u);
+	emmc_wr(EMMC_BYTCNT, bytes);
+	emmc_wr(EMMC_RINTSTS, 0xffffffffu);
+	emmc_wr(EMMC_CMDARG, lba);
+	uint32_t command = CMD_START | CMD_WAIT_DATA | CMD_DATA | CMD_RESP_CRC |
+	    CMD_RESP | (write ? CMD_WRITE | 25u : 18u);
+	if ((emmc_rd(EMMC_CLKSEL) >> 16) & 7u) command |= CMD_HOLD;
+	data_started = true;
+	phase = 3;
+	emmc_wr(EMMC_CMD, command);
+	for (unsigned i = 0; ; i++) {
+		uint32_t pending = emmc_rd(EMMC_RINTSTS);
+		if (pending & INT_ERRORS) { error = EIO; goto out; }
+		if ((pending & INT_CMD_DONE) && (emmc_rd(EMMC_RESP0) & A5_EMMC_R1_ERRORS)) {
+			error = EIO; goto out;
+		}
+		uint32_t fifo = (emmc_rd(EMMC_STATUS) >> 17) & 0x1fffu;
+		if (fifo > EMMC_FIFO_DEPTH) { error = EIO; goto out; }
+		uint32_t available = write ? EMMC_FIFO_DEPTH - fifo : fifo;
+		/* Do not push data until the write command has an accepted response. */
+		if (write && !(pending & INT_CMD_DONE)) available = 0;
+		while (available && moved < bytes) {
+			uint64_t value = 0;
+			if (write) {
+				memcpy(&value, buffer + moved, unit);
+				if (unit == 8) {
+					emmc_wr(data_off, (uint32_t)value);
+					emmc_wr(data_off + 4, (uint32_t)(value >> 32));
+				} else if (unit == 4) emmc_wr(data_off, (uint32_t)value);
+				else *(volatile uint16_t *)(emmc_regs + data_off) = (uint16_t)value;
+			} else {
+				if (unit == 8) {
+					value = emmc_rd(data_off);
+					value |= (uint64_t)emmc_rd(data_off + 4) << 32;
+				} else if (unit == 4) value = emmc_rd(data_off);
+				else value = *(volatile uint16_t *)(emmc_regs + data_off);
+				memcpy(buffer + moved, &value, unit);
+			}
+			moved += unit; available--;
+		}
+		uint32_t request = write ? INT_TXDR : INT_RXDR;
+		if (pending & request) emmc_wr(EMMC_RINTSTS, request);
+		if (moved == bytes && (pending & INT_CMD_DONE) && (pending & INT_DATA_OVER)) break;
+		if (i == A5_EMMC_POLL_LIMIT - 1) { error = ETIMEDOUT; goto out; }
+	}
+	phase = 4;
+	error = emmc_wait_idle();
+	/* dw_mci completes SBC data from command/data events and PIO length,
+	 * not TCBCNT equality. Keep both hardware counters as observations;
+	 * rejecting a completed transfer then issuing CMD12 can itself fail
+	 * because the bounded CMD23 transfer already returned to TRAN. */
+	if (!error && emmc_multi_reads + emmc_multi_writes < 4) {
+		printf("A5XELTE eMMC multi: complete write=%u blocks=%u moved=%u tcbc=%u tbbc=%u\n",
+		    write, blocks, moved, emmc_rd(EMMC_TCBCNT), emmc_rd(EMMC_TBBCNT));
+	}
+out:
+	if (error) {
+		printf("A5XELTE eMMC multi: phase=%u error=%d rint=%x resp=%x status=%x tcbc=%u tbbc=%u\n",
+		    phase, error, emmc_rd(EMMC_RINTSTS), emmc_rd(EMMC_RESP0),
+		    emmc_rd(EMMC_STATUS), emmc_rd(EMMC_TCBCNT), emmc_rd(EMMC_TBBCNT));
+	}
+	if (error && data_started) {
+		uint32_t stop_response = 0;
+		int stopped = emmc_command(12u, 0, true, &stop_response);
+		int idle = emmc_wait_idle();
+		if (stopped || idle) emmc_io_poisoned = true;
+		printf("A5XELTE eMMC multi: error=%d write=%u blocks=%u moved=%u stop=%d idle=%d poisoned=%u\n",
+		    error, write, blocks, moved, stopped, idle, emmc_io_poisoned);
+	}
+	if (error && !data_started && error != ENOTSUP) emmc_io_poisoned = true;
+	if (error && !data_started) {
+		printf("A5XELTE eMMC multi: setup error=%d response=%x fallback=%u poisoned=%u\n",
+		    error, response, error == ENOTSUP, emmc_io_poisoned);
+	}
+	if (error) emmc_multi_blocks = 1;
+	else if (write) { emmc_multi_writes++; emmc_multi_write_blocks += blocks; }
+	else { emmc_multi_reads++; emmc_multi_read_blocks += blocks; }
+	emmc_wr(EMMC_RINTSTS, 0xffffffffu);
+	emmc_wr(EMMC_INTMASK, ints);
+	return error;
+}
