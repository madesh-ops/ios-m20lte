  * 0x10580000, Power GPA2 pin 4, Volume Up/Down and Home GPA0 pins 3/4/5,
  * active low.  S-Boot reads them too, so their mux is already set; the two
  * DAT registers are sampled together (bits 0-7 GPA0, 8-15 GPA2).
+ *
+ * M20LTE (Galaxy M20, Exynos 7904; ztOS DTS gpio-keys, mainline
+ * pinctrl-exynos-arm64.c exynos7885_pin_banks0): ALIVE at 0x11cb0000, GPA1
+ * at +0x60; Volume Up/Down and Power on GPA1 pins 5/6/7, active low. No
+ * Home key: its pin index 15 lies outside the 8-bit sample and never changes.
  */
 #if defined(ARM64_BOARD_CONFIG_A5XELTE)
 #include <sys/param.h>
@@ -28,6 +33,11 @@ extern void sweet_hid_key(int key, int down);
 #define A5_GPA0_CON 0x00u
 #define A5_GPA0_DAT 0x04u
 #define A5_GPA0_PUD 0x08u
+#elif defined(ARM64_BOARD_CONFIG_M20LTE)
+#define A5_ALIVE_PA 0x11cb0000u
+#define A5_GPA1_CON 0x60u
+#define A5_GPA1_DAT 0x64u
+#define A5_GPA1_PUD 0x68u
 #else
 #define A5_ALIVE_PA 0x139b0000u
 #endif
@@ -68,6 +78,13 @@ a5_keys_sample(void)
 	       ((a5_keys_read(A5_GPA2_DAT) & 0xff) << 8));
 }
 static const uint8_t a5_key_pins[4] = {8 + 4, 3, 4, 5};
+#elif defined(ARM64_BOARD_CONFIG_M20LTE)
+static uint16_t
+a5_keys_sample(void)
+{
+	return (uint16_t)(a5_keys_read(A5_GPA1_DAT) & 0xff);
+}
+static const uint8_t a5_key_pins[4] = {7, 5, 6, 15};
 #else
 static uint16_t
 a5_keys_sample(void)
@@ -138,9 +155,15 @@ a5xelte_keys_init(void)
 	    a5_keys_read(A5_GPA0_CON), a5_keys_read(A5_GPA0_DAT),
 	    a5_keys_read(A5_GPA0_PUD));
 #endif
+#if defined(ARM64_BOARD_CONFIG_M20LTE)
+	printf("A5XELTE KEYS: M20 GPA1 con=%#x dat=%#x pud=%#x (read only)\n",
+	    a5_keys_read(A5_GPA1_CON), a5_keys_read(A5_GPA1_DAT),
