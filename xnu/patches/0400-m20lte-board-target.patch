--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -29,7 +29,7 @@ SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else ifneq ($(findstring _host,$(RC_ProjectName)),)
 SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else
-SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 T6000 T8101 T8103 VMAPPLE SWEET A5XELTE HEROLTE
+SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 T6000 T8101 T8103 VMAPPLE SWEET A5XELTE HEROLTE M20LTE
 
 endif
 
@@ -65,6 +65,9 @@ MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=arm
 MACHINE_FLAGS_ARM64_A5XELTE = -DARM64_BOARD_CONFIG_A5XELTE            -mcpu=cortex-a53 -march=armv8-a+crypto
 # Galaxy S7 (Exynos 8890) boots on a Cortex-A53 and reuses the A5XELTE port.
 MACHINE_FLAGS_ARM64_HEROLTE = -DARM64_BOARD_CONFIG_A5XELTE -DARM64_BOARD_CONFIG_HEROLTE -mcpu=cortex-a53 -march=armv8-a+crypto
+# Galaxy M20 (Exynos 7904) boots on a Cortex-A53 and reuses the A5XELTE port
+# (eMMC, GICv2, 4 KiB pages) with its own addresses (pexpert/arm64/A5XELTE.h).
+MACHINE_FLAGS_ARM64_M20LTE = -DARM64_BOARD_CONFIG_A5XELTE -DARM64_BOARD_CONFIG_M20LTE -mcpu=cortex-a53 -march=armv8-a+crypto
 
 
 #
@@ -264,7 +267,7 @@ ifeq ($(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG),)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := $(shell echo $(CURRENT_ARCH_CONFIG) | tr A-Z a-z)
 ifneq ($(filter arm64,$(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG)),)
 # These generic ARMv8 targets do not use Apple's arm64e pointer authentication.
-ifeq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET A5XELTE HEROLTE),)
+ifeq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET A5XELTE HEROLTE M20LTE),)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := arm64e
 endif
 endif
@@ -343,7 +346,7 @@ endif
 # Exynos7580 uses 4 KiB pages: TTBR1 has a 39-bit range. The macOS
 # ARM_LARGE_MEMORY link address at -2 TiB is outside that range. Keep this
 # board inside the existing compact kernel VA layout instead.
-ifneq ($(filter $(CURRENT_MACHINE_CONFIG),A5XELTE HEROLTE),)
+ifneq ($(filter $(CURRENT_MACHINE_CONFIG),A5XELTE HEROLTE M20LTE),)
 LARGE_MEMORY_DEFINE=-UARM_LARGE_MEMORY
 ARM64_PLKSEG_ADDR  =0xfffffff004004000
 ARM64_LINK_ADDR    =0xfffffff007004000
diff --git a/pexpert/pexpert/arm64/A5XELTE.h b/pexpert/pexpert/arm64/A5XELTE.h
index 8f9c8a2..2c4e16d 100644
--- a/pexpert/pexpert/arm64/A5XELTE.h
+++ b/pexpert/pexpert/arm64/A5XELTE.h
@@ -26,6 +26,22 @@
 #define A5XELTE_MARKER_PA             0x8ffff100
 /* S-Boot starts on the Cortex-A53 "Apollo" cluster, Aff1 = 1. */
 #define A5XELTE_BOOT_MPIDR            0x100
+#elif defined(ARM64_BOARD_CONFIG_M20LTE)
+/* Galaxy M20 SM-M205F (Exynos 7904): S-Boot leaves DECON_F scanning out
+ * this buffer (uniLoader board-a30.c); the loader's log page is 0xc7fff000.
+ * Probe 2 (M20LTE_PROGRESS.md): S-Boot enters on the Cortex-A53 MPIDR 0x100. */
+#define M20LTE                        1
+#define SWEET_SMP_MAX_CPUS            1
+#define A5XELTE_FB_PA                 0xec000000
+#define A5XELTE_FB_WIDTH              1080
+#define A5XELTE_FB_HEIGHT             2340
+#define A5XELTE_FB_STRIDE             4320
+#define A5XELTE_FB_BLOCKS             5     /* 2 MiB VA=PA blocks: 10,108,800 bytes */
+#define A5XELTE_FB_TEXT_SCALE         2
+#define A5XELTE_FB_DOT_PITCH          409   /* 1080 pixels across 6.3 inches */
+#define A5XELTE_MARKER_PA             0xc7fff100
+#define A5XELTE_BOOT_MPIDR            0x100
+#define A5XELTE_EMMC_PA               0x13500000
 #else
 #define SWEET_SMP_MAX_CPUS            1
 #define A5XELTE_FB_PA                 0x67000000
@@ -38,6 +54,9 @@
 #define A5XELTE_MARKER_PA             0x469ff100
 #define A5XELTE_BOOT_MPIDR            0x0
 #endif
+#ifndef A5XELTE_EMMC_PA
+#define A5XELTE_EMMC_PA               0x13540000    /* Exynos 7580 MSHC0 */
+#endif
 
 #define ARM_ARCH_TIMER
 #define __ARM_ARCH__                  8
